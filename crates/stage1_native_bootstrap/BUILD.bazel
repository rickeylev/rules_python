load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//python/private:distribution_filegroup.bzl", "distribution_filegroup")  # buildifier: disable=bzl-visibility

package(default_visibility = ["//:__subpackages__"])

licenses(["notice"])

rust_library(
    name = "stage1_native_bootstrap_lib",
    srcs = ["src/lib.rs"],
    edition = "2021",
)

rust_binary(
    name = "stage1_native_bootstrap_template",
    srcs = ["src/template_main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [":stage1_native_bootstrap_lib"],
)

rust_binary(
    name = "stage1_native_bootstrap_embedder",
    srcs = ["src/embedder_main.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = ["//crates/native_bootstrap_embedder:native_bootstrap_embedder_lib"],
)

distribution_filegroup(
    name = "distribution",
)
