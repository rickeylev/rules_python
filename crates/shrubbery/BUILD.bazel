load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//python/private:distribution_filegroup.bzl", "distribution_filegroup")  # buildifier: disable=bzl-visibility

package(default_visibility = ["//:__subpackages__"])

licenses(["notice"])

rust_library(
    name = "shrubbery_lib",
    srcs = ["src/lib.rs"],
    edition = "2024",
    deps = [
        "//crates/build_data_writer:build_data_writer_lib",
        "//crates/exe_zip_maker:exe_zip_maker_lib",
        "//crates/extract_wheel_files:extract_wheel_files_lib",
        "//crates/py_console_script_gen:py_console_script_gen_lib",
        "//crates/py_test_main_validator:py_test_main_validator_lib",
        "//crates/py_wheel_dist:py_wheel_dist_lib",
        "//crates/venv_shebang_rewriter:venv_shebang_rewriter_lib",
        "//crates/wheel_record_rewriter:wheel_record_rewriter_lib",
        "//crates/wheelmaker:wheelmaker_lib",
        "//crates/zip_main_maker:zip_main_maker_lib",
        "//crates/zipper:zipper_lib",
    ],
)

rust_binary(
    name = "shrubbery",
    srcs = ["src/main.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [":shrubbery_lib"],
)

distribution_filegroup(
    name = "distribution",
)
