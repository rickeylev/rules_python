load("//python:py_library.bzl", "py_library")
load("//python:py_test.bzl", "py_test")
load("//tests/support:support.bzl", "NOT_WINDOWS")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "fetch_pr_queue",
    testonly = True,
    srcs = ["fetch_pr_queue.py"],
    imports = ["."],
    target_compatible_with = NOT_WINDOWS,
)

py_library(
    name = "server",
    testonly = True,
    srcs = ["server.py"],
    data = ["index.html"],
    imports = ["."],
    target_compatible_with = NOT_WINDOWS,
    deps = [":fetch_pr_queue"],
)

py_test(
    name = "fetch_pr_queue_test",
    size = "small",
    srcs = ["fetch_pr_queue_test.py"],
    target_compatible_with = NOT_WINDOWS,
    deps = [":fetch_pr_queue"],
)

py_test(
    name = "server_test",
    size = "small",
    srcs = ["server_test.py"],
    target_compatible_with = NOT_WINDOWS,
    deps = [
        ":fetch_pr_queue",
        ":server",
    ],
)
